{
  "name": "bomberman-js-remake",
  "version": "1.0.0",
  "description": "Remake of NES Bomberman (1983) using JavaScript & HTML5 Canvas",
  "main": "index.js",
  "scripts": {
    "build": "webpack",
    "start": "webpack serve",
    "test": "mocha \"test/**/*.test.js\" --require esbuild-register --require test/setup.js --reporter spec",
    "coverage": "c8 --include 'src/**/*.js' --check-coverage --lines 80 --branches 65 --functions 70 npm test",
    "lint": "eslint src",
    "lint:test": "eslint test"
  },
  "keywords": [
    "nes",
    "bomberman"
  ],
  "author": "Egor Romanov <unsaidxpl@gmail.com>",
  "lint-staged": {
    "*.{js,json,md}": [
      "prettier --write",
      "git add"
    ],
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^9.1.0",
    "css-loader": "^7.1.2",
    "esbuild-register": "^3.6.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.14.0",
    "lint-staged": "^16.2.6",
    "mini-css-extract-plugin": "^2.9.4",
    "mocha": "^11.7.5",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "lodash": "^4.18.1"
  }
}
